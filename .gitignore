cat > .gitignore << 'EOF'
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.env
.venv/
venv/
.ipynb_checkpoints/

# OS/IDE
.DS_Store
.vscode/
.idea/

# Data & artifacts (giữ repo sạch)
data/**/*.csv
data/**/*.parquet
data/**/*.json
!data/README.md

# ZenML, runs, logs
mlruns/
runs/
artifacts/
.cache/
EOF
